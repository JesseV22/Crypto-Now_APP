<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@android:color/transparent"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/ivCryptoIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/crypto_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCryptoSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BTCUSDT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvMarketCap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$1.2T MKT CAP"
            android:textSize="12sp"
            android:textColor="#A0A0A0"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvCryptoPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$94,884.980"
            android:textSize="16sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvCryptoChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0.37%"
            android:textSize="12sp"
            android:textColor="@color/green"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>