<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/top_gainer_background"
    android:padding="8dp"
    android:layout_marginEnd="8dp"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/ivTopGainerIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/top_gainer_icon" />

    <TextView
        android:id="@+id/tvTopGainerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="BTCUSDT"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvTopGainerChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="+3.05%"
        android:textSize="12sp"
        android:textColor="@color/green"
        android:layout_marginTop="4dp" />
</LinearLayout>