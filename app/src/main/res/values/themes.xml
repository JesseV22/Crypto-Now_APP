<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CryptoNow" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background and text -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/light_gray</item>
        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize action bar -->
        <item name="android:actionBarStyle">@style/Theme.CryptoNow.ActionBar</item>
        <item name="android:background">?android:attr/windowBackground</item>
    </style>

    <style name="Theme.CryptoNow.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/dark_background</item>
        <item name="titleTextColor">@color/white</item>
    </style>
</resources>